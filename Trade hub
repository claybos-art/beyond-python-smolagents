// --- Component: Edit Listing Modal ---
const EditListingModal = ({ isOpen, onClose, db, listing, onListingUpdated }) => {
    // Initialize state using listing data. Use useEffect to update if listing changes (re-opening for a new item)
    const [itemName, setItemName] = useState('');
    const [description, setDescription] = useState('');
    const [wants, setWants] = useState('');
    const [imageUrl, setImageUrl] = useState('');
    const [status, setStatus] = useState('available');
    const [isSaving, setIsSaving] = useState(false);
    const [error, setError] = useState(null);

    // Note: The edit modal does not support uploading new photos via file input 
    // to keep the complexity manageable, only updating the URL field.
    useEffect(() => {
        if (listing) {
            setItemName(listing.itemName || '');
            setDescription(listing.description || '');
            setWants(listing.wants || '');
            // If the URL is a long Base64 string, don't show it in the input to avoid UX issues
            const currentImageUrl = listing.imageUrl || '';
            const isBase64 = currentImageUrl.startsWith('data:image/');
            setImageUrl(isBase64 ? 'Image uploaded via camera/file (Base64 data)' : currentImageUrl);
            setStatus(listing.status || 'available');
            setError(null);
        }
    }, [listing]);

    const handleSubmit = async (e) => {
        e.preventDefault();
        if (!itemName || !description || !wants || !listing?.id) {
            setError("All item details must be filled out to update the listing.");
            return;
        }

        setIsSaving(true);
        setError(null);

        // Keep the original URL if the user hasn't changed the disabled input
        const finalImageUrl = imageUrl.startsWith('Image uploaded via camera') ? listing.imageUrl : imageUrl.trim();

        try {
            const docRef = doc(db, `artifacts/${appId}/public/data/listings`, listing.id);
            await updateDoc(docRef, {
                itemName: itemName.trim(),
                description: description.trim(),
                wants: wants.trim(),
                imageUrl: finalImageUrl,
                status: status,
            });

            onListingUpdated();
            onClose();
        } catch (e) {
            console.error("Error updating document: ", e);
            setError("Failed to update listing. Please check your connection.");
        } finally {
            setIsSaving(false);
        }
    };

    if (!isOpen || !listing) return null;

    return (
        <div className="fixed inset-0 z-50 bg-gray-900 bg-opacity-75 flex items-center justify-center p-4">
            <div className="bg-white rounded-2xl w-full max-w-lg p-6 shadow-2xl transform transition-all">
                <h3 className="text-2xl font-bold text-gray-800 mb-4 border-b pb-2">Edit Listing: {listing.itemName}</h3>
                
                {error && <p className="text-sm text-red-500 font-medium mb-4">{error}</p>}

                <form onSubmit={handleSubmit} className="space-y-4">
                    <div>
                        <label className="block text-sm font-semibold text-gray-700 mb-1">Item I Have:</label>
                        <input
                            type="text"
                            value={itemName}
                            onChange={(e) => setItemName(e.target.value)}
                            className="w-full p-3 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 transition duration-150"
                            required
                        />
                    </div>
                    <div>
                        <label className="block text-sm font-semibold text-gray-700 mb-1">Description:</label>
                        <textarea
                            value={description}
                            onChange={(e) => setDescription(e.target.value)}
                            rows="3"
                            className="w-full p-3 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 transition duration-150 resize-none"
                            required
                        ></textarea>
                    </div>
                    <div>
                        <label className="block text-sm font-semibold text-gray-700 mb-1">What I Want In Exchange:</label>
                        <input
                            type="text"
                            value={wants}
                            onChange={(e) => setWants(e.target.value)}
                            className="w-full p-3 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 transition duration-150"
                            required
                        />
                    </div>
                    <div>
                        <label className="block text-sm font-semibold text-gray-700 mb-1">Image URL (Optional):</label>
                        <input
                            type="url"
                            value={imageUrl}
                            onChange={(e) => setImageUrl(e.target.value)}
                            className="w-full p-3 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 transition duration-150"
                            disabled={imageUrl.startsWith('Image uploaded via camera')} // Disable if it's a long base64 string
                        />
                         {imageUrl.startsWith('Image uploaded via camera') && (
                             <p className="text-xs text-gray-500 mt-1">
                                To update this image, please delete and re-list, or paste a new image URL above.
                             </p>
                         )}
                    </div>
                    
                    <div>
                        <label className="block text-sm font-semibold text-gray-700 mb-1">Status:</label>
                        <select
                            value={status}
                            onChange={(e) => setStatus(e.target.value)}
                            className="w-full p-3 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 transition duration-150"
                        >
                            <option value="available">Available (Ready to Trade)</option>
                            <option value="traded">Traded (Inactive)</option>
                        </select>
                    </div>

                    <div className="flex justify-end space-x-3 pt-4">
                        <button
                            type="button"
                            onClick={onClose}
                            className="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-xl transition duration-150"
                            disabled={isSaving}
                        >
                            Cancel
                        </button>
                        <button
                            type="submit"
                            className="bg-teal-500 hover:bg-teal-600 text-white font-bold py-2 px-4 rounded-xl shadow-lg transition duration-150 disabled:opacity-50"
                            disabled={isSaving}
                        >
                            {isSaving ? 'Saving...' : 'Save Changes'}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    );
};

// --- Component: Rating Modal ---
const RatingModal = ({ isOpen, onClose, db, reviewerId, targetUserId, targetUserName, onRatingSubmitted }) => {
    const [score, setScore] = useState(0);
    const [comment, setComment] = useState('');
    const [isSaving, setIsSaving] = useState(false);
    const [error, setError] = useState(null);

    // Reset state when modal opens/closes
    useEffect(() => {
        if (isOpen) {
            setScore(0);
            setComment('');
            setError(null);
        }
    }, [isOpen]);

    const handleSubmit = async () => {
        if (score === 0) {
            setError("Please select a score (1-5 stars).");
            return;
        }
        if (reviewerId === targetUserId) {
             setError("You cannot rate yourself!");
            return;
        }

        setIsSaving(true);
        setError(null);

        try {
            const q = query(
                getRatingsCollectionRef(db, appId),
                where("reviewerId", "==", reviewerId),
                where("ratedUserId", "==", targetUserId)
            );
            const snapshot = await getDocs(q);

            if (!snapshot.empty) {
                setError("You have already submitted a rating for this user.");
                setIsSaving(false);
                return;
            }

            await addDoc(getRatingsCollectionRef(db, appId), {
                ratedUserId: targetUserId,
                reviewerId: reviewerId,
                score: score,
                comment: comment.trim(),
                ratedAt: serverTimestamp(),
            });

            onRatingSubmitted(); 
            onClose(); 
        } catch (e) {
            console.error("Error adding rating: ", e);
            setError("Failed to submit rating. Please check your connection.");
        } finally {
            setIsSaving(false);
        }
    };

    if (!isOpen) return null;

    return (
        <div className="fixed inset-0 z-50 bg-gray-900 bg-opacity-75 flex items-center justify-center p-4">
            <div className="bg-white rounded-2xl w-full max-w-lg p-6 shadow-2xl transform transition-all">
                <h3 className="text-2xl font-bold text-gray-800 mb-4 border-b pb-2">Rate {targetUserName}</h3>
                <p className="text-sm text-gray-600 mb-4">You are rating user: <span className="font-mono text-xs break-all text-indigo-600">{targetUserId}</span></p>

                <div className="mb-4">
                    <label className="block text-sm font-semibold text-gray-700 mb-2">Your Score:</label>
                    <div className="flex space-x-1">
                        {[1, 2, 3, 4, 5].map((i) => (
                            <button
                                key={i}
                                type="button"
                                onClick={() => setScore(i)}
                                className={`p-1 rounded-full transition duration-150 ${i <= score ? 'text-yellow-400' : 'text-gray-300'} hover:scale-110`}
                            >
                                <StarIcon fill={i <= score} />
                            </button>
                        ))}
                    </div>
                </div>

                <div className="mb-6">
                    <label className="block text-sm font-semibold text-gray-700 mb-2">Comment (Optional):</label>
                    <textarea
                        value={comment}
                        onChange={(e) => setComment(e.target.value)}
                        placeholder="Share your experience (e.g., 'Quick communication' or 'Item was exactly as described')."
                        rows="3"
                        className="w-full p-3 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 transition duration-150 resize-none"
                    ></textarea>
                </div>

                {error && <p className="text-sm text-red-500 font-medium mb-4">{error}</p>}

                <div className="flex justify-end space-x-3">
                    <button
                        onClick={onClose}
                        className="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-xl transition duration-150"
                        disabled={isSaving}
                    >
                        Cancel
                    </button>
                    <button
                        onClick={handleSubmit}
                        className="bg-teal-500 hover:bg-teal-600 text-white font-bold py-2 px-4 rounded-xl shadow-lg transition duration-150 disabled:opacity-50"
                        disabled={isSaving || score === 0}
                    >
                        {isSaving ? 'Submitting...' : 'Submit Rating'}
                    </button>
                </div>
            </div>
        </div>
    );
};


// --- Component: Authentication Panel ---
const AuthPanel = ({ auth, user, userRatings }) => {
    const isAnonymous = user?.isAnonymous;
    const provider = new GoogleAuthProvider();

    const handleGoogleSignIn = async () => {
        try {
            await signInWithPopup(auth, provider);
        } catch (error) {
            console.error("Google Sign-In Error:", error);
        }
    };

    const handleSignOut = async () => {
        try {
            await signOut(auth);
            await signInAnonymously(auth); 
        } catch (error) {
            console.error("Sign-Out Error:", error);
        }
    };

    if (!user) {
        return <p className="text-gray-500 text-sm">Authentication loading...</p>;
    }

    const currentUserRating = userRatings[user.uid];

    if (isAnonymous) {
